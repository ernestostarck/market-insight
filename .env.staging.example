# ==============================================================================
# MercadoInsight - Configuración para Entorno de Staging / Pre-producción
# ==============================================================================
# Copie este archivo a `.env.staging` (ignorado por git) y complete TODOS los valores.
#
# Comando de ejecución:
#   docker compose --env-file .env.staging -f docker-compose.yml -f docker/compose/docker-compose.staging.yml up -d --build
#
# Generación de secretos seguros:
#   openssl rand -hex 24        # Para contraseñas de BD, Redis, MinIO
#   python -c "import secrets; print(secrets.token_hex(32))"   # Para SECRET_KEY

# URL pública de Staging servida por NGINX (sin slash final)
PUBLIC_BASE_URL=https://staging.mercadoinsight.cl

APP_ENV=staging
ENVIRONMENT=staging
APP_NAME=MercadoInsight Staging
APP_VERSION=0.1.0
DEBUG=false

LOG_LEVEL=INFO
LOG_FORMAT=json

# Seguridad - OBLIGATORIO (el sistema aborta si se usa el placeholder)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=https://staging.mercadoinsight.cl
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ChileCompra API (Credencial de homologación o staging)
CHILECOMPRA_API_URL=https://api.mercadopublico.cl/servicios/v1/publico
CHILECOMPRA_API_KEY=

# IA / LLM
LLM_PROVIDER=openai
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Base de datos PostgreSQL de Staging
POSTGRES_PASSWORD=
MARKET_INSIGHT_ADMIN_PASSWORD=
MARKET_INSIGHT_APP_PASSWORD=
MARKET_INSIGHT_READONLY_PASSWORD=

# Redis Staging
REDIS_PASSWORD=

# MinIO Staging
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Grafana Staging
GRAFANA_ADMIN_PASSWORD=

# Observabilidad Staging
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.5
OTEL_ENABLED=true

# Alertas y Notificaciones Staging
ALERT_WEBHOOK_TOKEN=
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
