# Production secrets template. Copy to .env.prod (gitignored) and fill EVERY value:
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker/compose/docker-compose.prod.yml up -d --build
# Compose aborts if a required variable is empty. Use URL-safe values (no @ : / ? #):
#   openssl rand -hex 24        # passwords
#   python -c "import secrets; print(secrets.token_hex(32))"   # SECRET_KEY

# Environment Identifier
APP_ENV=production
ENVIRONMENT=production

# Public URL served by nginx (scheme + host, no trailing slash). Used for CORS and Grafana/Alertmanager links.
PUBLIC_BASE_URL=

SECRET_KEY=
CHILECOMPRA_API_KEY=

# LLM / AI Configuration
LLM_PROVIDER=openai
LLM_API_KEY=

POSTGRES_PASSWORD=
MARKET_INSIGHT_ADMIN_PASSWORD=
MARKET_INSIGHT_APP_PASSWORD=
MARKET_INSIGHT_READONLY_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

GRAFANA_ADMIN_PASSWORD=

# Optional: error tracking. Leave empty to disable Sentry.
SENTRY_DSN=

# Alertmanager notifications (email) and the shared token between Alertmanager and the API webhook.
# Critical and warning alerts are emailed to ALERT_EMAIL_TO; info alerts are only logged.
ALERT_WEBHOOK_TOKEN=
ALERT_SMTP_HOST=            # host:port, e.g. smtp.yourprovider.com:587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
