# ==============================================================================
# MercadoInsight - Configuración de Entorno (Plantilla de Desarrollo)
# ==============================================================================
# Copie este archivo a `.env` para desarrollo local con Docker Compose o localmente.
# NOTA: Nunca coloque credenciales reales de producción en este archivo.

# --- Identificación y Entorno ---
# Valores soportados: development, test, staging, production
APP_ENV=development
ENVIRONMENT=development
APP_NAME=MercadoInsight API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

# --- Logging y Telemetría ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# auto = legible en consola para development, JSON para staging/production
LOG_FORMAT=auto
LOG_SQL=false

# Sentry (opcional en desarrollo, recomendado en staging y production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=market-insight-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Seguridad y Autenticación ---
# En producción/staging debe generarse con: python -c "import secrets; print(secrets.token_hex(32))"
# El backend rechaza iniciar con el placeholder en staging y production.
# Firma los JWT y deriva la clave que cifra los secretos MFA: si se rota, los usuarios
# con MFA deben volver a configurarlo. Mínimo 32 caracteres fuera de development.
SECRET_KEY=change-me-in-production
# Token de acceso corto; la sesión se renueva con un refresh token rotativo (cookie httpOnly)
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_MAX_HOURS=8
JWT_ISSUER=market-insight-api
JWT_AUDIENCE=market-insight-web
# Vacío = automático (true fuera de development: la cookie solo viaja por HTTPS)
REFRESH_COOKIE_SECURE=
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:80

# Protección de credenciales
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
PASSWORD_MIN_LENGTH=12
MFA_ISSUER=Market Insight

# Firewall de aplicación (WAF)
FIREWALL_ENABLED=true
# IPs/CIDR separados por coma. Si FIREWALL_IP_ALLOWLIST tiene valores, todo lo demás se rechaza.
FIREWALL_IP_ALLOWLIST=
FIREWALL_IP_DENYLIST=
FIREWALL_BAN_THRESHOLD=20
FIREWALL_BAN_SECONDS=900
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BODY_BYTES=26214400
# En producción: los dominios reales de la API (ej. api.midominio.cl)
ALLOWED_HOSTS=*
# Proxies cuyo X-Forwarded-For es confiable (nginx/ingress); el resto no puede falsear su IP
TRUSTED_PROXIES=127.0.0.1,::1

# Tokens internos de observabilidad y alertas
METRICS_AUTH_TOKEN=
ALERT_WEBHOOK_TOKEN=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- ChileCompra / Mercado Público API ---
CHILECOMPRA_API_URL=https://api.mercadopublico.cl/servicios/v1/publico
CHILECOMPRA_API_KEY=
CHILECOMPRA_API_TICKET=
CHILECOMPRA_TIMEOUT=30
CHILECOMPRA_MAX_RETRIES=3
CHILECOMPRA_RETRY_DELAY=0.5

# --- Proveedor de IA / LLM ---
# local, openai, anthropic
LLM_PROVIDER=local
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_NAME=claude-3-5-sonnet-latest
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# --- Base de Datos PostgreSQL (OLTP + pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=market_insight
POSTGRES_USER=market_insight
POSTGRES_PASSWORD=market_insight_dev
MARKET_INSIGHT_ADMIN_PASSWORD=market_insight_admin_dev
MARKET_INSIGHT_APP_PASSWORD=market_insight_app_dev
MARKET_INSIGHT_READONLY_PASSWORD=market_insight_readonly_dev
DATABASE_URL=postgresql+psycopg://market_insight_app:market_insight_app_dev@postgres:5432/market_insight

# --- Cache y Colas (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=market_insight_redis_dev
REDIS_URL=redis://:market_insight_redis_dev@redis:6379/0

# --- Object Storage (MinIO / S3) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=marketinsight
MINIO_ROOT_PASSWORD=marketinsight-dev-password
MINIO_ACCESS_KEY=marketinsight
MINIO_SECRET_KEY=marketinsight-dev-password
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_PUBLIC_DOCUMENTS=documents-public
MINIO_BUCKET_PRIVATE_DOCUMENTS=documents-private
MINIO_BUCKET_ATTACHMENTS=attachments
MINIO_BUCKET_ML_MODELS=ml-models

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1
