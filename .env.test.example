# ==============================================================================
# MercadoInsight - Configuración para Entorno de Testing / CI
# ==============================================================================
# Este archivo sirve como plantilla para pipelines de CI y tests de integración.
# Los contenedores se ejecutan sin puertos expuestos en el host (puertos !reset []).

APP_ENV=test
ENVIRONMENT=test
APP_NAME=MercadoInsight Test Runner
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SQL=false

# Clave secreta fija para entorno de pruebas automatizadas
SECRET_KEY=test-secret-key-32-chars-strictly-for-testing!!
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=false

# ChileCompra en modo test (los tests de integración usan fixtures o mocks)
CHILECOMPRA_API_URL=https://api.mercadopublico.cl/servicios/v1/publico
CHILECOMPRA_API_KEY=test_ticket_dummy_key
CHILECOMPRA_API_TICKET=test_ticket_dummy_key
CHILECOMPRA_TIMEOUT=5.0
CHILECOMPRA_MAX_RETRIES=1
CHILECOMPRA_RETRY_DELAY=0.1

# AI en modo local / mock
LLM_PROVIDER=local
LLM_API_KEY=test-llm-key
OPENAI_API_KEY=test-llm-key

# Base de datos de prueba aislada
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=market_insight_test
POSTGRES_USER=market_insight
POSTGRES_PASSWORD=market_insight_test_dev
MARKET_INSIGHT_ADMIN_PASSWORD=market_insight_test_admin
MARKET_INSIGHT_APP_PASSWORD=market_insight_test_app
MARKET_INSIGHT_READONLY_PASSWORD=market_insight_test_ro
DATABASE_URL=postgresql+psycopg://market_insight:market_insight_test_dev@postgres:5432/market_insight_test

# Redis de prueba
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=market_insight_redis_test
REDIS_URL=redis://:market_insight_redis_test@redis:6379/1

# MinIO de prueba
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=marketinsight-test
MINIO_ROOT_PASSWORD=marketinsight-test-password
MINIO_ACCESS_KEY=marketinsight-test
MINIO_SECRET_KEY=marketinsight-test-password
MINIO_BUCKET_DOCUMENTS=test-documents
MINIO_BUCKET_PUBLIC_DOCUMENTS=test-documents-public
MINIO_BUCKET_PRIVATE_DOCUMENTS=test-documents-private
MINIO_BUCKET_ATTACHMENTS=test-attachments
MINIO_BUCKET_ML_MODELS=test-ml-models

# Observabilidad desactivada en tests
SENTRY_DSN=
OTEL_ENABLED=false
METRICS_AUTH_TOKEN=test-metrics-token-123
ALERT_WEBHOOK_TOKEN=test-alert-webhook-token-123
