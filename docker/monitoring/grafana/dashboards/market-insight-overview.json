{
  "uid": "market-insight-overview",
  "title": "MercadoInsight — General Overview",
  "tags": [
    "market-insight",
    "overview",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "System Health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "API Status",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"backend\"}",
          "legendFormat": "FastAPI"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "PostgreSQL Status",
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"postgres-exporter\"}",
          "legendFormat": "Postgres"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Redis Status",
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"redis-exporter\"}",
          "legendFormat": "Redis"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "ETL Pipeline Status",
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "expr": "(time() - etl_last_success_timestamp) < 86400",
          "legendFormat": "ETL Fresh"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "STALE / DOWN",
                  "color": "yellow"
                },
                "1": {
                  "text": "ACTIVE",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "ChileCompra Public API",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "chilecompra_up",
          "legendFormat": "ChileCompra API"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNREACHABLE",
                  "color": "red"
                },
                "1": {
                  "text": "REACHABLE",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "description": "Technical reachability of the ChileCompra API (probe every 60 s). Data freshness is shown separately."
    },
    {
      "type": "row",
      "title": "Data & ETL Metrics",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Última Ingesta Exitosa",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "time() - etl_last_success_timestamp",
          "legendFormat": "Tiempo desde última sync"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 14400,
                "color": "yellow"
              },
              {
                "value": 86400,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Registros Procesados",
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(etl_records_processed_total)",
          "legendFormat": "Registros"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Errores de Ingesta",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(etl_records_failed_total)",
          "legendFormat": "Errores"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 10,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Data Freshness Delta",
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "data_freshness_seconds",
          "legendFormat": "Freshness (segundos)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "row",
      "title": "API Performance",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Requests por Minuto (RPM)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) * 60",
          "legendFormat": "RPM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rpm"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Latencia P95 y P99",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P99 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error Rate (% 5xx y 4xx)",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "(sum(rate(http_errors_total{error_class=\"server_error\"}[5m])) / (sum(rate(http_requests_total[5m])) + 0.001)) * 100",
          "legendFormat": "5xx Server Error %"
        },
        {
          "expr": "(sum(rate(http_errors_total{error_class=\"client_error\"}[5m])) / (sum(rate(http_requests_total[5m])) + 0.001)) * 100",
          "legendFormat": "4xx Client Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "type": "row",
      "title": "Infrastructure",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "CPU Usage de Contenedores",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memoria de Contenedores",
      "gridPos": {
        "x": 6,
        "y": 20,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "stat",
      "title": "PostgreSQL Conexiones",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends)",
          "legendFormat": "Conexiones activas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 50,
                "color": "yellow"
              },
              {
                "value": 85,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Redis Memoria Usada",
      "gridPos": {
        "x": 18,
        "y": 20,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Memoria"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 268435456,
                "color": "yellow"
              },
              {
                "value": 536870912,
                "color": "red"
              }
            ]
          }
        }
      }
    }
  ]
}
