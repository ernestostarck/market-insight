{
  "uid": "postgresql-monitoring",
  "title": "MercadoInsight — PostgreSQL Database Monitoring",
  "tags": ["market-insight", "postgres", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview & Connection Status",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "PostgreSQL Exporter Status",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "up{job=\"postgres-exporter\"}", "legendFormat": "Status" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Conexiones Totales",
      "gridPos": { "x": 4, "y": 1, "w": 5, "h": 4 },
      "targets": [{ "expr": "sum(pg_stat_database_numbackends)", "legendFormat": "Total Backends" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "type": "stat",
      "title": "Conexiones Activas",
      "gridPos": { "x": 9, "y": 1, "w": 5, "h": 4 },
      "targets": [{ "expr": "sum(pg_stat_activity_count{state=\"active\"}) or sum(pg_stat_database_numbackends)", "legendFormat": "Active" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Saturación de Conexiones (%)",
      "gridPos": { "x": 14, "y": 1, "w": 5, "h": 4 },
      "targets": [{ "expr": "(sum(pg_stat_database_numbackends) / sum(pg_settings_max_connections)) * 100", "legendFormat": "% Max Connections" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "yellow" },
              { "value": 85, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Cache Hit Ratio (%)",
      "gridPos": { "x": 19, "y": 1, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "(sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])) + 0.001)) * 100",
          "legendFormat": "Hit Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 80, "color": "yellow" },
              { "value": 95, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Transacciones, Commits & Rollbacks",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Tasa de Transacciones (TPS)",
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit[5m])) + sum(rate(pg_stat_database_xact_rollback[5m]))",
          "legendFormat": "Total TPS"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "tps" }
      }
    },
    {
      "type": "timeseries",
      "title": "Commits vs Rollbacks",
      "gridPos": { "x": 8, "y": 6, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit[5m]))",
          "legendFormat": "Commits/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback[5m]))",
          "legendFormat": "Rollbacks/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "tps" }
      }
    },
    {
      "type": "timeseries",
      "title": "Deadlocks Detectados",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_deadlocks[5m]))",
          "legendFormat": "Deadlocks/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "type": "row",
      "title": "Locks, Almacenamiento & Duración de Queries",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Locks en Base de Datos",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum by (mode) (pg_locks_count)",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "type": "timeseries",
      "title": "Tamaño de la Base de Datos",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"market_insight\"}",
          "legendFormat": "market_insight DB Size"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "type": "timeseries",
      "title": "Duración de Transacciones Activas",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "pg_stat_activity_max_tx_duration or 0",
          "legendFormat": "Max Tx Duration"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ]
}
